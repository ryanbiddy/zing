# Cross-repository conformance fixtures are hashed byte-for-byte by consumers.
# Keep the canonical provider bytes identical on every platform.
tools/eval/fixtures/suite_v1/source-url.json text eol=lf

# Bundled font files and their upstream OFL texts are hashed against the
# upstream bytes in sources.json (the OFL.txt files ship with CRLF).
src/myzing/_data/fonts/** -text

# P4 deterministic exports and compatibility byte snapshots.
src/myzing/_data/schemas/*.json text eol=lf
docs/examples/composition-v2/*.json text eol=lf
tests/fixtures/composition-v2/*.json text eol=lf
tests/fixtures/render-v1-baseline.json text eol=lf
tests/fixtures/render-v2-no-lut-baseline.json text eol=lf
tests/fixtures/render-v2-graded-cut-baseline.json text eol=lf

# P10b overlay cache hashes these sidecar sources byte-for-byte.
tools/hyperframes-sidecar/render.mjs text eol=lf
tools/hyperframes-sidecar/plan.mjs text eol=lf
tools/hyperframes-sidecar/templates.mjs text eol=lf
tools/hyperframes-sidecar/offline.cjs text eol=lf
tools/hyperframes-sidecar/package-lock.json text eol=lf

# Real-evaluation provenance hashes these files byte-for-byte.
tools/eval/real/*.json text eol=lf
tools/eval/real/*.py text eol=lf
