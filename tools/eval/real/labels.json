  "version": 1,
  "annotator": "Codex visual inspection, 2026-10-21; not independently human-validated",
  "method": {
    "transitions": "First surveyed original FFmpeg overview PNGs, then inspected every normalized frame in the declared windows, using timestamped 8x10 sheets. Checked Zing inspect timeline PNGs as context. Cut = first fully new shot; isolated one/two-frame archival blends are treated as cut uncertainty, not a gradual dissolve. No detector outputs were used to place these boundaries.",
    "captions": "Manually transcribed visible title lines and estimated tight visible-ink axis-aligned boxes from native-resolution FFmpeg PNGs, before inspecting OCR boxes. Normalized [left,top,right,bottom]. Full-frame labels exclude unreadable incidental scenery and the small archival calibration mark.",
    "faces": "Visible human face presence at exact 0.5-second sample times; cartoon turtle, back of head, fully covered faces and opaque helmets are not visible human faces. Ambiguous tiny/profile faces are null. Presence scoring does not measure every-face recall or layout safety.",
    "audio": "Audio cannot be reliably auditioned in this session. Music/beat labels remain null pending a listening review. Waveform, ASR and detector output are not independent music truth.",
    "fonts": "Source font family is unknown; no identity labels fabricated.",
    "color": "One identical-file pair is an identity invariant; unrelated-scene pairs have no known original grade or pixel correspondence."
  },
  "thresholds": {
    "confidence": 0.8,
    "cut_tolerance_frames": 2,
    "interval_iou": 0.5,
    "caption_iou": 0.5,
